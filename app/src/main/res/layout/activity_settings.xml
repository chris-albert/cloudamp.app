<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/winamp_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Google Drive Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_gdrive"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOOGLE DRIVE"
                android:textColor="@color/winamp_text"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Create OAuth credentials at:\nhttps://console.cloud.google.com\n\n2. Enable the Google Drive API\n\n3. Create an OAuth 2.0 Client ID\n   (Desktop application type)\n\n4. Copy the Client ID and Secret below"
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/gdriveClientIdEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Google OAuth Client ID"
            android:textColor="@color/winamp_text"
            android:textColorHint="@color/winamp_display_text"
            android:background="@color/winamp_list_background"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:inputType="textPassword"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/gdriveClientSecretEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Google OAuth Client Secret"
            android:textColor="@color/winamp_text"
            android:textColorHint="@color/winamp_display_text"
            android:background="@color/winamp_list_background"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:inputType="textPassword"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/saveGdriveCredentialsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE CREDENTIALS"
            android:textColor="@color/winamp_text"
            android:background="@color/winamp_button"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/loginWithGdriveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOGIN WITH GOOGLE DRIVE"
            android:textColor="@color/winamp_text"
            android:background="@color/winamp_button"
            android:fontFamily="monospace"
            android:enabled="false"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/clearGdriveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CLEAR GOOGLE DRIVE"
            android:textColor="@color/winamp_text"
            android:background="@color/winamp_button"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/gdriveValidationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:visibility="gone"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nNote: Google Drive provides read-only access\nto your personal music files."
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="16dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/winamp_text"
            android:layout_marginVertical="16dp"/>

        <!-- GDrive Music Library Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GDrive Music Library"
            android:textColor="@color/winamp_text"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/gdriveMusicRootText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Music root: Not set"
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/gdriveBrowseRootButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BROWSE FOR MUSIC FOLDER"
            android:textColor="@color/winamp_text"
            android:background="@color/winamp_button"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/gdriveLastLoadedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last loaded: Never"
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/gdriveLibraryStatsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/reloadGdriveLibraryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RELOAD GDRIVE LIBRARY"
            android:textColor="@color/winamp_text"
            android:background="@color/winamp_button"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/gdriveScanStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

        <ProgressBar
            android:id="@+id/gdriveScanProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:visibility="gone"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/winamp_text"
            android:layout_marginVertical="16dp"/>

        <!-- Streaming Cache Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Streaming Cache"
            android:textColor="@color/winamp_text"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/mediaCacheUsageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 B / 1.00 GB"
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <ProgressBar
            android:id="@+id/mediaCacheProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/mediaCacheCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 tracks cached"
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/mediaCacheLimitText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Max size: 1 GB"
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <Button
            android:id="@+id/changeMediaCacheLimitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHANGE MAX SIZE"
            android:textColor="@color/winamp_text"
            android:background="@color/winamp_button"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/mediaCacheTracksContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/clearMediaCacheButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CLEAR STREAMING CACHE"
            android:textColor="@color/winamp_text"
            android:background="@color/winamp_button"
            android:fontFamily="monospace"/>

    </LinearLayout>
</ScrollView>
