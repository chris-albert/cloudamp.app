<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/winamp_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Spotify Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_spotify"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPOTIFY"
                android:textColor="@color/winamp_text"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- OAuth Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OAuth Login (Recommended)"
            android:textColor="@color/winamp_text"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Get your Client ID and Secret from:\nhttps://developer.spotify.com/dashboard"
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Add this Redirect URI to your app:\ncloudamp://callback"
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/clientIdEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Client ID"
            android:textColor="@color/winamp_text"
            android:textColorHint="@color/winamp_display_text"
            android:background="@color/winamp_list_background"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:inputType="textPassword"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/clientSecretEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Client Secret"
            android:textColor="@color/winamp_text"
            android:textColorHint="@color/winamp_display_text"
            android:background="@color/winamp_list_background"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:inputType="textPassword"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/saveCredentialsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE CREDENTIALS"
            android:textColor="@color/winamp_text"
            android:background="@color/winamp_button"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/loginWithSpotifyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOGIN WITH SPOTIFY"
            android:textColor="@color/winamp_text"
            android:background="@color/winamp_button"
            android:fontFamily="monospace"
            android:enabled="false"
            android:layout_marginBottom="24dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/winamp_text"
            android:layout_marginVertical="16dp"/>

        <!-- Manual Token Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manual Token (Advanced)"
            android:textColor="@color/winamp_text"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Get a temporary token from:\nhttps://developer.spotify.com/console"
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/tokenEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paste access token here"
            android:textColor="@color/winamp_text"
            android:textColorHint="@color/winamp_display_text"
            android:background="@color/winamp_list_background"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:inputType="textPassword"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveTokenButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SAVE"
                android:textColor="@color/winamp_text"
                android:background="@color/winamp_button"
                android:fontFamily="monospace"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/clearTokenButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CLEAR ALL"
                android:textColor="@color/winamp_text"
                android:background="@color/winamp_button"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- Validation Progress and Status -->
        <ProgressBar
            android:id="@+id/validationProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:indeterminateTint="@color/winamp_text"/>

        <TextView
            android:id="@+id/validationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:visibility="gone"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nNote: You need Spotify Premium to control playback.\n\nOAuth login provides automatic token refresh."
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="24dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/winamp_text"
            android:layout_marginVertical="16dp"/>

        <!-- Library Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Library"
            android:textColor="@color/winamp_text"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/lastLoadedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last loaded: Never"
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/reloadLibraryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RELOAD LIBRARY"
            android:textColor="@color/winamp_text"
            android:background="@color/winamp_button"
            android:fontFamily="monospace"/>

        <!-- Double Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/winamp_text"
            android:layout_marginVertical="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/winamp_text"
            android:layout_marginBottom="16dp"/>

        <!-- Google Drive Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_gdrive"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOOGLE DRIVE"
                android:textColor="@color/winamp_text"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Create OAuth credentials at:\nhttps://console.cloud.google.com\n\n2. Enable the Google Drive API\n\n3. Create an OAuth 2.0 Client ID\n   (Desktop application type)\n\n4. Copy the Client ID and Secret below"
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/gdriveClientIdEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Google OAuth Client ID"
            android:textColor="@color/winamp_text"
            android:textColorHint="@color/winamp_display_text"
            android:background="@color/winamp_list_background"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:inputType="textPassword"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/gdriveClientSecretEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Google OAuth Client Secret"
            android:textColor="@color/winamp_text"
            android:textColorHint="@color/winamp_display_text"
            android:background="@color/winamp_list_background"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:inputType="textPassword"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/saveGdriveCredentialsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE CREDENTIALS"
            android:textColor="@color/winamp_text"
            android:background="@color/winamp_button"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/loginWithGdriveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOGIN WITH GOOGLE DRIVE"
            android:textColor="@color/winamp_text"
            android:background="@color/winamp_button"
            android:fontFamily="monospace"
            android:enabled="false"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/clearGdriveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CLEAR GOOGLE DRIVE"
            android:textColor="@color/winamp_text"
            android:background="@color/winamp_button"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/gdriveValidationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:visibility="gone"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nNote: Google Drive provides read-only access\nto your personal music files."
            android:textColor="@color/winamp_display_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
