<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@color/winamp_background">

    <TextView
        android:id="@+id/queuePositionTextView"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:textColor="@color/winamp_display_text"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="center"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:layout_gravity="center_vertical">

        <TextView
            android:id="@+id/queueTrackNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/winamp_text"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/queueTrackArtistTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/winamp_display_text"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/queueTrackCacheIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginStart="8dp"
        android:contentDescription="Cache state"/>

    <TextView
        android:id="@+id/queueTrackDurationTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:textColor="@color/winamp_display_text"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_marginStart="8dp"/>
</LinearLayout>
