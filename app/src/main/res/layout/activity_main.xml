<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/winamp_background">

    <!-- Main Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/winamp_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Artists Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▶ ARTISTS"
                android:textColor="@color/winamp_text"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:background="@color/winamp_section_header"
                android:padding="8dp"/>

            <!-- Library content with alphabet sidebar -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Single RecyclerView for Accordion-style Library -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/libraryRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/winamp_background"
                    android:clipToPadding="false"
                    android:paddingEnd="24dp"/>

                <!-- A-Z Fast Scroll Sidebar -->
                <com.cloudamp.music.ui.AlphabetSidebarView
                    android:id="@+id/alphabetSidebar"
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:background="@color/winamp_section_header"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone"/>

            </FrameLayout>

        </LinearLayout>

        <!-- Loading Overlay -->
        <LinearLayout
            android:id="@+id/loadingContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/winamp_background"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading library..."
                android:textColor="@color/winamp_text"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:layout_marginTop="16dp"/>

        </LinearLayout>

    </FrameLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/winamp_header"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_drawer_menu"
        app:itemTextColor="@color/winamp_text"
        app:itemIconTint="@color/winamp_text"/>

</androidx.drawerlayout.widget.DrawerLayout>
