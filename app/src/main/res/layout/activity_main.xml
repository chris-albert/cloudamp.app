<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/winamp_background">

    <!-- CloudAmp Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/winamp_header"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CloudAmp"
            android:textColor="@color/winamp_display_text"
            android:textSize="24sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="It really whips the llama's ass!"
            android:textColor="@color/winamp_display_text"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:alpha="0.7"/>
    </LinearLayout>

    <!-- Artists Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="▶ ARTISTS"
        android:textColor="@color/winamp_text"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:background="@color/winamp_section_header"
        android:padding="8dp"/>

    <!-- Single RecyclerView for Accordion-style Library -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/libraryRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/winamp_background"/>

</LinearLayout>
