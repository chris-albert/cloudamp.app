{
  "processes": [
    {
      "name": "dev",
      "description": "Vite dev server",
      "command": "cd web && npm run dev",
      "slots": [
        { "name": "WEB", "port": 3049 }
      ]
    },
    {
      "name": "emulator",
      "description": "Emulator",
      "command": "ANDROID_HOME=/opt/homebrew/share/android-commandlinetools /opt/homebrew/share/android-commandlinetools/emulator/emulator -avd cloudamp"
    },
    {
      "name": "deploy app",
      "description": "Deploy app",
      "command": "cd android && ./gradlew installDebug"
    }
  ]
}
