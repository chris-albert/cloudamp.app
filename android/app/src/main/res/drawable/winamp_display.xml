<?xml version="1.0" encoding="utf-8"?>
<!-- Winamp 2.x LCD display: black face sunken into the chrome. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- dark edge top/left (sunken) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0E16"/>
        </shape>
    </item>
    <!-- light edge bottom/right -->
    <item android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#667088"/>
        </shape>
    </item>
    <!-- black LCD face -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/winamp_display"/>
        </shape>
    </item>
</layer-list>
