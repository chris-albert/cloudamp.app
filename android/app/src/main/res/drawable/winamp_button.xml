<?xml version="1.0" encoding="utf-8"?>
<!-- Winamp 2.x style beveled button: raised silver-steel, sinks when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- dark edge top/left (sunken) -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#171B26"/>
                </shape>
            </item>
            <!-- light edge bottom/right -->
            <item android:left="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#98A2B6"/>
                </shape>
            </item>
            <!-- pressed face, darker -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#4E586E"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- light edge top/left (raised) -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#C6CEDC"/>
                </shape>
            </item>
            <!-- dark edge bottom/right -->
            <item android:left="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#171B26"/>
                </shape>
            </item>
            <!-- silver-steel face -->
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#8A94A8"
                        android:centerColor="@color/winamp_button"
                        android:endColor="#5F6980"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
