<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============ Classic Green (default) ============ -->
    <style name="Theme.CloudAmp" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/classic_header</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/classic_text</item>
        <item name="android:windowBackground">@color/classic_background</item>
        <item name="android:textColorPrimary">@color/classic_text</item>
        <item name="android:textColorSecondary">@color/classic_display_text</item>
        <item name="actionBarStyle">@style/CloudAmpActionBar</item>
        <!-- custom attrs -->
        <item name="caBackground">@color/classic_background</item>
        <item name="caHeader">@color/classic_header</item>
        <item name="caSectionHeader">@color/classic_section_header</item>
        <item name="caListBackground">@color/classic_list_background</item>
        <item name="caDisplay">@color/classic_display</item>
        <item name="caButtonSection">@color/classic_button_section</item>
        <item name="caText">@color/classic_text</item>
        <item name="caDisplayText">@color/classic_display_text</item>
        <item name="caButton">@color/classic_button</item>
        <item name="caButtonPressed">@color/classic_button_pressed</item>
        <item name="caPlayerFrame">@color/classic_player_frame</item>
        <item name="caSeekbarBackground">@color/classic_seekbar_bg</item>
    </style>

