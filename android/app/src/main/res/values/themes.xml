    <!-- ============ ActionBar styles per theme ============ -->
    <style name="CloudAmpActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/classic_header</item>
        <item name="titleTextStyle">@style/CloudAmpActionBarTitle</item>
    </style>
    <style name="CloudAmpActionBar.WinampClassic" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/winamp_header</item>
        <item name="titleTextStyle">@style/CloudAmpActionBarTitle.WinampClassic</item>
    </style>
    <style name="CloudAmpActionBar.DarkSide" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/darkside_header</item>
        <item name="titleTextStyle">@style/CloudAmpActionBarTitle.DarkSide</item>
    </style>
    <style name="CloudAmpActionBar.Vapor" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/vapor_header</item>
        <item name="titleTextStyle">@style/CloudAmpActionBarTitle.Vapor</item>
    </style>
    <style name="CloudAmpActionBar.Nuclear" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/nuclear_header</item>
        <item name="titleTextStyle">@style/CloudAmpActionBarTitle.Nuclear</item>
    </style>

    <!-- ============ ActionBar title styles ============ -->
    <style name="CloudAmpActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/classic_text</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="CloudAmpActionBarTitle.WinampClassic" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/winamp_text</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="CloudAmpActionBarTitle.DarkSide" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/darkside_text</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="CloudAmpActionBarTitle.Vapor" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/vapor_text</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="CloudAmpActionBarTitle.Nuclear" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/nuclear_text</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- ============ Shared styles ============ -->
    <style name="CloudAmpNavSubheader" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textSize">0sp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="Theme.CloudAmp.Fullscreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="Theme.CloudAmp.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/classic_text</item>
        <item name="android:background">@color/classic_header</item>
        <item name="android:textColorPrimary">@color/classic_text</item>
        <item name="android:textColorSecondary">@color/classic_display_text</item>
    </style>
</resources>
