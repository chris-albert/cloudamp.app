<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/caBackground">

    <!-- Header: name + track count -->
    <TextView
        android:id="@+id/playlistHeaderTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/caText"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:background="?attr/caSectionHeader"
        android:padding="8dp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- Play / Shuffle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/caButtonSection"
        android:padding="8dp">

        <Button
            android:id="@+id/playButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="▶ PLAY"
            android:fontFamily="monospace"
            android:textColor="?attr/caText"
            android:background="?attr/caButton"/>

        <Button
            android:id="@+id/shuffleButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="⇄ SHUFFLE"
            android:fontFamily="monospace"
            android:textColor="?attr/caText"
            android:background="?attr/caButton"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tracksRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/caBackground"/>

        <LinearLayout
            android:id="@+id/emptyContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/caBackground"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Playlist is empty"
                android:textColor="?attr/caText"
                android:textSize="16sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Long-press a track in Library or Drive\nto add it here."
                android:textColor="?attr/caDisplayText"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </FrameLayout>

    <include layout="@layout/mini_player_bar" />

</LinearLayout>
