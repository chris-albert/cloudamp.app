<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="4dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="?attr/caBackground"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/playlistTrackPosition"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:textColor="?attr/caDisplayText"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/playlistTrackName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/caText"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/playlistTrackArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/caDisplayText"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/removeButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_delete"
        android:contentDescription="Remove from playlist"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/dragHandle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="☰"
        android:gravity="center"
        android:textColor="?attr/caDisplayText"
        android:textSize="18sp"
        android:contentDescription="Drag to reorder" />

</LinearLayout>
