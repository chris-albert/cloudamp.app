<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/caBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Skin Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SKIN"
            android:textColor="?attr/caText"
            android:textSize="20sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/currentSkinText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current: Classic Green"
            android:textColor="?attr/caDisplayText"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/changeSkinButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHANGE SKIN"
            android:textColor="?attr/caText"
            android:background="?attr/caButton"
            android:fontFamily="monospace"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="?attr/caText"
            android:layout_marginVertical="16dp"/>

        <!-- Google Drive Section Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_gdrive"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOOGLE DRIVE"
                android:textColor="?attr/caText"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>

        </LinearLayout>

        <Button
            android:id="@+id/loginWithGdriveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOGIN WITH GOOGLE DRIVE"
            android:textColor="?attr/caText"
            android:background="?attr/caButton"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/clearGdriveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CLEAR GOOGLE DRIVE"
            android:textColor="?attr/caText"
            android:background="?attr/caButton"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/gdriveValidationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:visibility="gone"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\nConnect your Google Drive to stream\nyour personal music library."
            android:textColor="?attr/caDisplayText"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="16dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="?attr/caText"
            android:layout_marginVertical="16dp"/>

        <!-- GDrive Music Library Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GDrive Music Library"
            android:textColor="?attr/caText"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/gdriveMusicRootText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Music root: Not set"
            android:textColor="?attr/caDisplayText"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/gdriveBrowseRootButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BROWSE FOR MUSIC FOLDER"
            android:textColor="?attr/caText"
            android:background="?attr/caButton"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/gdriveLastLoadedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last loaded: Never"
            android:textColor="?attr/caDisplayText"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/gdriveLibraryStatsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/caDisplayText"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/reloadGdriveLibraryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RELOAD GDRIVE LIBRARY"
            android:textColor="?attr/caText"
            android:background="?attr/caButton"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/gdriveScanStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/caDisplayText"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

        <ProgressBar
            android:id="@+id/gdriveScanProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:visibility="gone"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="?attr/caText"
            android:layout_marginVertical="16dp"/>

        <!-- Streaming Cache Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Streaming Cache"
            android:textColor="?attr/caText"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/mediaCacheUsageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 B / 1.00 GB"
            android:textColor="?attr/caDisplayText"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <ProgressBar
            android:id="@+id/mediaCacheProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/mediaCacheCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 tracks cached"
            android:textColor="?attr/caDisplayText"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/mediaCacheLimitText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Max size: 1 GB"
            android:textColor="?attr/caDisplayText"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <Button
            android:id="@+id/changeMediaCacheLimitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHANGE MAX SIZE"
            android:textColor="?attr/caText"
            android:background="?attr/caButton"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/clearMediaCacheButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CLEAR STREAMING CACHE"
            android:textColor="?attr/caText"
            android:background="?attr/caButton"
            android:fontFamily="monospace"/>

        <!-- Version -->
        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/caDisplayText"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>
