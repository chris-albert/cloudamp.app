<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/caListBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/expandIcon"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:text="▶"
        android:textColor="?attr/caText"
        android:textSize="12sp"
        android:fontFamily="monospace"/>

    <ImageView
        android:id="@+id/playlistImageView"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:scaleType="centerCrop"
        android:contentDescription="Playlist image"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/playlistNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/caText"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/playlistTracksTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/caDisplayText"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"/>

    </LinearLayout>
</LinearLayout>
